{
  "name": "agentsview-snapshot-site",
  "version": "0.0.0",
  "private": true,
  "description": "Cloudflare Worker serving a read-only agentsview snapshot (SPA + /api/v1) over D1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8799",
    "schema": "wrangler d1 execute agentsview-snapshot --local --file",
    "load": "node scripts/load.mjs",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260617.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.101.0"
  }
}
